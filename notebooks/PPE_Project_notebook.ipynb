import os
import random
import cv2
import matplotlib.pyplot as plt
import pandas as pd


path="/kaggle/input/datasets/vanshindulkar/ppe-dataset"


img_len=[]
for root, dirs, files in os.walk(path):
    for file in files:
        if file.lower().endswith(".jpg"):
            img_len.append(os.path.join(root, file))



print(len(img_len))


img_path=[]
for root,dirs,files in os.walk(path):
    for file in files:
        if file.endswith(".jpg"):
            img_path.append(os.path.join(root,file))

random_images=random.sample(img_path,10)

plt.figure(figsize=(12,8))

for i,img_paths in enumerate(random_images):
    img=cv2.imread(img_paths)
    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    plt.subplot(2, 5, i + 1) 
    plt.imshow(img) 
    plt.title(os.path.basename(img_paths), fontsize=8) 
    plt.axis("off")


pip install ultralytics


from ultralytics import YOLO


with open("/kaggle/input/datasets/vanshindulkar/ppe-dataset/data.yaml") as f:
    print(f.read())


get_ipython().run_cell_magic("writefile", " /kaggle/working/data.yaml", """
train: /kaggle/input/datasets/vanshindulkar/ppe-dataset/train/images
val: /kaggle/input/datasets/vanshindulkar/ppe-dataset/valid/images

nc: 4

names:
  0: glove
  1: harness
  2: helmet
  3: safety shoes""")


from ultralytics import YOLO

model = YOLO("yolo11s.pt")   

model.train(
    data="/kaggle/working/data.yaml",
    epochs=25,
    imgsz=640,
    batch=16,
    optimizer="AdamW",
    lr0=0.001,
    patience=20,
    weight_decay=0.0005,
    cos_lr=True,
    cache=True,
    workers=8,
    project="PPE",
    name="YOLO11S_v1",
    device=0
)


import matplotlib.pyplot as plt

plt.figure(figsize=(20,10))

for i, img_path in enumerate(random_images):

    # Run prediction
    results = model.predict(img_path, conf=0.25, verbose=False)

    # Get image with bounding boxes
    predicted_img = results[0].plot()

    predicted_img = predicted_img[:, :, ::-1]

    plt.subplot(2,5,i+1)
    plt.imshow(predicted_img)
    plt.title(os.path.basename(img_path), fontsize=8)
    plt.axis("off")

plt.tight_layout()
plt.show()


df = pd.read_csv("/kaggle/working/runs/detect/PPE/YOLO11S_v1/results.csv")
print(df.head()) 


plt.figure(figsize=(8,5))

plt.plot(df["epoch"], df["train/box_loss"], label="Train")
plt.plot(df["epoch"], df["val/box_loss"], label="Validation")

plt.title("Train vs Validation Box Loss")
plt.xlabel("Epoch")
plt.ylabel("Loss")
plt.legend()
plt.grid(True)

plt.show()


plt.figure(figsize=(8,5))

plt.plot(df["epoch"], df["metrics/mAP50(B)"], label="mAP@50")
plt.plot(df["epoch"], df["metrics/mAP50-95(B)"], label="mAP@50-95")

plt.title("mAP During Training")
plt.xlabel("Epoch")
plt.ylabel("mAP")
plt.legend()
plt.grid(True)

plt.show()


